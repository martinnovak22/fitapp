EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_EMAIL_REDIRECT_TO=fitapp://login

# Sentry DSN — public client key, safe to ship. Settings → Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only: source map upload for readable production stack traces.
SENTRY_ORG=
SENTRY_PROJECT=
# Secret — never commit. Set as an EAS secret for CI builds.
SENTRY_AUTH_TOKEN=
